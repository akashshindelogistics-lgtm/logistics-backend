# Caddy terminates TLS (auto Let's Encrypt, HTTP-01 challenge on port 80) and
# proxies everything to the API container. The API already sends permissive
# CORS headers, so the GitHub Pages origin can call it directly.

{$DOMAIN} {
	encode zstd gzip
	tls {$ACME_EMAIL}

	# Prometheus scrape endpoint; not for the internet.
	respond /metrics 404

	reverse_proxy api:8080

	# The MSG91 delivery-report webhook carries its secret in `?secret=`;
	# keep it out of the access log.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					replace secret REDACTED
				}
			}
		}
	}
}
